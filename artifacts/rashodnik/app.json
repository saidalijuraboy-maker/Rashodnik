{
  "expo": {
    "name": "Расходник",
    "slug": "rashodnik",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rashodnik",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rashodnik.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Face ID используется для безопасной разблокировки приложения Расходник."
      }
    },
    "android": {
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-local-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "238e3418-32e2-4028-a73f-58e4ca4abb64"
      }
    },
    "owner": "replit-private-e6f8caa1-6011-4881-bc33-34ccaa3400e9"
  }
}
